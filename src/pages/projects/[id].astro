---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectIndex from '../../components/ProjectIndex.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const allProjects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    // Drafts get built (direct URLs still work) but never appear in prev/next
    // navigation, which only traverses publicly listed projects.
    const navProjects = allProjects.filter(({ data }) => !data.draft);
    return allProjects.map((project) => {
        const navIndex = navProjects.findIndex((p) => p.id === project.id);
        const isInNav = navIndex >= 0;
        return {
            params: { id: project.id },
            props: {
                project,
                // Section index at the top: the public list, plus the page
                // itself when it is a draft (same rule as Leadership).
                indexProjects: allProjects.filter((p) => !p.data.draft || p.id === project.id),
                prevProject: isInNav && navIndex + 1 !== navProjects.length ? navProjects[navIndex + 1] : null,
                nextProject: isInNav && navIndex !== 0 ? navProjects[navIndex - 1] : null
            }
        };
    });
}

type Props = {
    project: CollectionEntry<'projects'>;
    indexProjects: CollectionEntry<'projects'>[];
    prevProject: CollectionEntry<'projects'>;
    nextProject: CollectionEntry<'projects'>;
};

const { project, indexProjects, prevProject, nextProject } = Astro.props;
const { title, pageTitle, description, seo, draft } = project.data;
const { Content } = await render(project);
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? description}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    noindex={draft}
>
    <ProjectIndex projects={indexProjects} currentId={project.id} class="indent-text mb-10 sm:mb-16" />
    <article class="mb-12 md:mb-15">
        <header class="indent-heading mb-8 md:mb-10">
            <h1 class="page-title">{pageTitle ?? title}</h1>
        </header>
        <div class="prose sm:prose-lg flow max-w-none">
            <Content />
        </div>
    </article>
    {
        (prevProject || nextProject) && (
            <>
                <hr class="rule" />
                <div class="indent-text mt-12 mb-16 sm:mb-24 md:mt-15">
                    <h2 class="mb-4 text-sm font-medium opacity-60 sm:mb-6">View next</h2>
                    {nextProject && <ProjectPreview project={nextProject} class="mb-10 sm:mb-12" headingLevel="h3" />}
                    {prevProject && <ProjectPreview project={prevProject} class="mb-10 sm:mb-12" headingLevel="h3" />}
                </div>
            </>
        )
    }
</BaseLayout>

<script>
    import mediumZoom from 'medium-zoom';

    // Make every image inside the case-study prose container click-to-zoom.
    // The module is bundled and runs once on initial page load. To handle SPA
    // navigation via Astro's ClientRouter (view-transitions), we re-init on
    // `astro:after-swap` (fires the moment the new DOM is in place) — earlier
    // than `astro:page-load`, which waits for transitions + assets to settle.
    //
    // The instance is tracked on `window` so each re-init detaches the prior
    // listeners cleanly. Without that, stacked instances cause the first
    // click to open a ghost copy and break subsequent clicks.
    type ZoomInstance = ReturnType<typeof mediumZoom>;
    const w = window as Window & {
        __mediumZoom?: ZoomInstance | null;
        __mediumZoomListenersInstalled?: boolean;
    };

    function setupZoom() {
        w.__mediumZoom?.detach();
        w.__mediumZoom = mediumZoom('.prose img', {
            margin: 24,
            background: 'rgba(20, 20, 20, 0.6)',
            scrollOffset: 40
        });
    }

    if (!w.__mediumZoomListenersInstalled) {
        document.addEventListener('astro:after-swap', setupZoom);
        document.addEventListener('astro:page-load', setupZoom);
        w.__mediumZoomListenersInstalled = true;
    }
    setupZoom();
</script>
