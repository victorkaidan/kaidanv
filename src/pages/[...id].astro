---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    // `about.md` content is rendered inline on the home page (`/`) — don't
    // generate a separate `/about` route so the same text isn't published at
    // two URLs (duplicate content / SEO confusion). Legacy `/about` from the
    // WordPress site will be redirected to `/` by Phase 6's _redirects file.
    return pages
        .filter((page) => page.id !== 'about')
        .map((page) => ({
            params: { id: page.id },
            props: { page }
        }));
}

type Props = { page: CollectionEntry<'pages'> };

const { page } = Astro.props;
const { title, seo } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description} image={seo?.image} showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
</BaseLayout>
