---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import LeadershipIndex from '../../components/LeadershipIndex.astro';
import LeadershipReadNext from '../../components/LeadershipReadNext.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLeadershipNav } from '../../utils/data-utils';

export async function getStaticPaths() {
    const allEntries = await getCollection('leadership');
    // `overview` is served by index.astro at /leadership/, so it's excluded here.
    return allEntries
        .filter((entry) => entry.id !== 'overview')
        .map((entry) => ({
            params: { id: entry.id },
            props: { entry, ...getLeadershipNav(allEntries, entry.id) }
        }));
}

type Props = {
    entry: CollectionEntry<'leadership'>;
    series: CollectionEntry<'leadership'>[];
    next?: CollectionEntry<'leadership'>;
};

const { entry, series, next } = Astro.props;
const { title, subtitle, description, seo, draft } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? description}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    noindex={draft}
>
    <LeadershipIndex series={series} currentId={entry.id} class="mb-10 sm:mb-16" />
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            {subtitle && <p class="mt-3 font-serif text-xl leading-snug opacity-75 sm:text-2xl">{subtitle}</p>}
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
    {next && <LeadershipReadNext entry={next} class="mb-16 sm:mb-24" />}
</BaseLayout>
