---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import LeadershipIndex from '../../components/LeadershipIndex.astro';
import LeadershipReadNext from '../../components/LeadershipReadNext.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLeadershipNav } from '../../utils/data-utils';

export async function getStaticPaths() {
    const allEntries = await getCollection('leadership');
    // Every article, the overview included, lives at /leadership/<id>/. The
    // section URL /leadership/ is a redirect to the default article (see
    // astro.config.mjs and public/_redirects).
    return allEntries.map((entry) => ({
        params: { id: entry.id },
        props: { entry, ...getLeadershipNav(allEntries, entry.id) }
    }));
}

type Props = {
    entry: CollectionEntry<'leadership'>;
    series: CollectionEntry<'leadership'>[];
    next?: CollectionEntry<'leadership'>;
};

const { entry, series, next } = Astro.props;
const { title, subtitle, description, seo, draft } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? description}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    noindex={draft}
>
    <LeadershipIndex series={series} currentId={entry.id} class="indent-text mb-10 sm:mb-16" />
    <article class="mb-12 md:mb-15">
        <header class="indent-heading mb-8 md:mb-10">
            <h1 class="page-title">{title}</h1>
            {subtitle && <p class="mt-2 text-xl leading-snug opacity-75 md:text-2xl">{subtitle}</p>}
        </header>
        <div class="prose sm:prose-lg flow max-w-none">
            <Content />
        </div>
    </article>
    {
        next && (
            <>
                <hr class="rule" />
                <LeadershipReadNext entry={next} class="indent-text mt-12 mb-16 sm:mb-24 md:mt-15" />
            </>
        )
    }
</BaseLayout>
