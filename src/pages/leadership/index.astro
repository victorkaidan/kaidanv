---
import { getCollection, render } from 'astro:content';
import LeadershipIndex from '../../components/LeadershipIndex.astro';
import LeadershipReadNext from '../../components/LeadershipReadNext.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLeadershipNav } from '../../utils/data-utils';

// The section entry page renders the `overview` entry. The deep-dives are
// served by [id].astro.
const allEntries = await getCollection('leadership');
const overview = allEntries.find((entry) => entry.id === 'overview');
if (!overview) {
    throw new Error('Leadership overview entry (id "overview") not found in src/content/leadership/.');
}
const { title, description, seo, draft } = overview.data;
const { Content } = await render(overview);
const { series, next } = getLeadershipNav(allEntries, overview.id);
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? description}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    noindex={draft}
>
    <LeadershipIndex series={series} currentId={overview.id} class="mb-10 sm:mb-16" />
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
    {next && <LeadershipReadNext entry={next} class="mb-16 sm:mb-24" />}
</BaseLayout>
