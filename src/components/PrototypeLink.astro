---
// Call-to-action for case studies that come with a live prototype. Same pill
// as the home page buttons (Button.astro: 240x48, hairline border, accent
// hover), centered on the page with an optional note under it. The arrow
// says it opens in a new tab, so the case study stays where the reader left
// it. `data-astro-reload` keeps Astro's ClientRouter from intercepting the
// click when the prototype is served from the same domain
// (e.g. /projects/.../saini/).
import Button from './Button.astro';

type Props = {
    href: string;
    label?: string;
    note?: string;
    class?: string;
};

const { href, label = 'Open the prototype', note, class: className } = Astro.props;
---

<div class:list={['not-prose my-12 flex flex-col items-center gap-3 text-center sm:my-16', className]}>
    <Button href={href} target="_blank" rel="noopener" data-astro-reload class="w-full gap-2 sm:w-60">
        {label}
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.5">
            <path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
    </Button>
    {note && <p class="max-w-md text-sm leading-snug opacity-60">{note}</p>}
</div>
