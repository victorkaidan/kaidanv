---
// Call-to-action for case studies that come with a live prototype.
// Centered, larger than the standard Button, with generous vertical space so
// it reads as the page's primary action. Opens in a new tab so the case study
// stays where the reader left it. `data-astro-reload` keeps Astro's
// ClientRouter from intercepting the click when the prototype is served from
// the same domain (e.g. /prototypes/...).
type Props = {
    href: string;
    label?: string;
    note?: string;
    class?: string;
};

const { href, label = 'Open the prototype', note, class: className } = Astro.props;
---

<div class:list={['not-prose my-12 flex flex-col items-center gap-3 text-center sm:my-16', className]}>
    <a
        href={href}
        target="_blank"
        rel="noopener"
        data-astro-reload
        class="text-main border-main hover:bg-muted inline-flex items-center justify-center gap-3 rounded-full border-2 bg-transparent px-10 py-4 text-lg leading-tight font-medium whitespace-nowrap no-underline! transition-colors sm:px-12 sm:text-xl"
    >
        {label}
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4 fill-none stroke-current sm:h-5 sm:w-5" stroke-width="1.5">
            <path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
    </a>
    {note && <p class="max-w-md text-sm leading-snug opacity-60">{note}</p>}
</div>
