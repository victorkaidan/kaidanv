---
import { type CollectionEntry } from 'astro:content';
import { leadershipHref } from '../utils/data-utils';
import SectionIndex from './SectionIndex.astro';

// Section index above the H1 on every Leadership page (see SectionIndex for
// the behaviour). Label = `navTitle` (short) or `title`; the hover rail shows
// `navSubtitle` - the part of the title the short label drops - and
// `description`.
type Props = {
    series: CollectionEntry<'leadership'>[];
    currentId: string;
    class?: string;
};

const { series, currentId, class: className } = Astro.props;
const items = series.map((entry) => ({
    id: entry.id,
    href: leadershipHref(entry.id),
    label: entry.data.navTitle ?? entry.data.title,
    subtitle: entry.data.navSubtitle,
    description: entry.data.description
}));
---

<SectionIndex items={items} currentId={currentId} label="Leadership articles" idPrefix="leadership" class={className} />
