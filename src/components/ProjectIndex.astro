---
import { type CollectionEntry } from 'astro:content';
import SectionIndex from './SectionIndex.astro';

// Section index above the H1 on every case study page, same as on the
// Leadership pages (see SectionIndex for the behaviour). Lists the projects
// in the order of the /projects/ listing; label = `title`, the hover rail
// shows `navSubtitle` (the year) and `navDescription` (2-3 lines), falling
// back to the short listing `description`.
type Props = {
    projects: CollectionEntry<'projects'>[];
    currentId: string;
    class?: string;
};

const { projects, currentId, class: className } = Astro.props;
const items = projects.map((project) => ({
    id: project.id,
    href: `/projects/${project.id}/`,
    label: project.data.title,
    subtitle: project.data.navSubtitle,
    description: project.data.navDescription ?? project.data.description
}));
---

<SectionIndex items={items} currentId={currentId} label="Case studies" idPrefix="project" class={className} />
