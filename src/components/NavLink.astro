---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
    /** Classes for the current-page state. Bold everywhere (header, footer) - see .bold-reserve in global.css. */
    activeClass?: string;
};

const { href, class: className, activeClass = 'font-bold', ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, '');
---

{
    isActive ? (
        <span class:list={[className, activeClass]} aria-current="page">
            <slot />
        </span>
    ) : (
        <a class:list={[className]} href={href} {...props}>
            <slot />
        </a>
    )
}
