---
import NavLink from './NavLink.astro';
import siteConfig from '../data/site-config';

type Props = { class?: string };
const { class: className = 'max-w-3xl' } = Astro.props;

const socialLinks = siteConfig.socialLinks ?? [];
const navLinks = siteConfig.footerNavLinks ?? [];
const currentYear = new Date().getFullYear();
---

<footer class:list={['mx-auto w-full pt-12 pb-10 sm:pt-24 sm:pb-14', className]}>
    {
        navLinks.length > 0 && (
            <nav class="mb-4 flex flex-wrap gap-x-6 gap-y-1" aria-label="Footer navigation">
                {navLinks.map((link) => (
                    <NavLink class="link-accent text-sm" href={link.href}>
                        <span class="bold-reserve" data-label={link.text}>
                            {link.text}
                        </span>
                    </NavLink>
                ))}
            </nav>
        )
    }
    <div
        class:list={[
            'border-subtle flex flex-col gap-4 border-t pt-6',
            { 'sm:flex-row-reverse sm:items-center sm:justify-between': socialLinks.length > 0 }
        ]}
    >
        {
            socialLinks.length > 0 && (
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    {socialLinks.map((link) => (
                        <a
                            class="link-accent inline-flex items-center justify-center text-sm"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferer"
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
        <p class="text-sm">
            &copy; {currentYear}
            <a class="link-accent" href="/">{siteConfig.title}</a>. All rights reserved.
        </p>
    </div>
</footer>
