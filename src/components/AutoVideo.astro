---
// Silent, chrome-less looping video for case studies. Renders like a GIF -
// no player UI, no controls - but ships as H.264 MP4, which is an order of
// magnitude lighter than an equivalent GIF.
//
// Playback is native: `autoplay muted loop playsinline` is what browsers
// actually honour, and it works with JS disabled or still loading. The
// script below only *pauses* clips that scroll out of view, and re-arms
// playback if the browser refused the initial autoplay. Do not go back to
// a JS-only `play()` with `preload="none"` - there is nothing buffered at
// that moment, so the promise rejects and the poster stays up.
interface Props {
    src: string;
    poster?: string;
    alt: string;
    caption?: string;
}
const { src, poster, alt, caption } = Astro.props;
---

<figure class="auto-video">
    <video
        data-autovideo
        src={src}
        poster={poster}
        aria-label={alt}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture></video>
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .auto-video {
        margin: 2rem 0;
    }
    .auto-video video {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 4px;
    }
    .auto-video figcaption {
        font-size: 0.85rem;
        text-align: center;
        margin-top: 0.5rem;
        opacity: 0.7;
    }
</style>

<script>
    // Bundled once by Astro regardless of how many <AutoVideo> instances a
    // page has. Re-runs on ClientRouter navigation.
    const w = window as Window & { __autoVideoObserver?: IntersectionObserver };

    function videos() {
        return Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-autovideo]'));
    }

    function inViewport(v: HTMLVideoElement) {
        const r = v.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
    }

    // Some browsers only honour autoplay when `muted` is set as a property,
    // not merely as an attribute — set both.
    function tryPlay(v: HTMLVideoElement) {
        v.muted = true;
        void v.play().catch(() => {});
    }

    function setupAutoVideo() {
        const list = videos();
        if (!list.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            list.forEach((v) => {
                v.autoplay = false;
                v.controls = true;
                v.pause();
            });
            return;
        }

        list.forEach((v) => (v.muted = true));

        w.__autoVideoObserver?.disconnect();
        w.__autoVideoObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const video = entry.target as HTMLVideoElement;
                    if (entry.isIntersecting) tryPlay(video);
                    else video.pause();
                });
            },
            { threshold: 0.2 }
        );
        list.forEach((v) => w.__autoVideoObserver!.observe(v));

        // If the browser declined autoplay on load, the first interaction of
        // any kind is enough of a user gesture to start the visible clips.
        const rearm = () => videos().filter(inViewport).forEach(tryPlay);
        ['pointerdown', 'touchstart', 'keydown', 'scroll', 'wheel'].forEach((evt) =>
            window.addEventListener(evt, rearm, { once: true, passive: true })
        );
    }

    document.addEventListener('astro:after-swap', setupAutoVideo);
    document.addEventListener('astro:page-load', setupAutoVideo);
    setupAutoVideo();
</script>
