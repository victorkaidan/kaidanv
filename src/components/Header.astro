---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';

type Props = { class?: string };
const { class: className } = Astro.props;
---

<!-- Profile block on the home page: 80px portrait, name 30/38, role 14/22 (Figma "Profile"). -->
<header class:list={['mx-auto mb-12 flex w-full items-center gap-4 sm:gap-6 md:mb-20', className]}>
    {
        siteConfig.avatar?.src && (
            <a href="/" class="shrink-0">
                <CustomImage
                    class="aspect-square w-16 rounded-full object-cover sm:w-20"
                    {...siteConfig.avatar}
                    loading="eager"
                    fetchpriority="high"
                    width={80}
                    height={80}
                    widths={[80, 160]}
                    sizes="80px"
                />
            </a>
        )
    }
    <div class="flex grow flex-col gap-[3px]">
        <p class="text-2xl leading-tight sm:text-[30px] sm:leading-[38px]">{siteConfig.title}</p>
        {siteConfig.subtitle && <p class="text-sm leading-[22px]">{siteConfig.subtitle}</p>}
    </div>
</header>
